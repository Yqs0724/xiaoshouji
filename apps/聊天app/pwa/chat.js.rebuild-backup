  async function runCtxAction(action) {
    const p = ctxPayload;
    closeCtxMenu();
    if (!p || !action) return;
    if (action === "copy") {
      await copyCtxText(p.text);
      return;
    }
    if (action === "translate") {
      await translateCtxUi(p);
      return;
    }
    if (action === "react") {
      openReactSheet(p);
      return;
    }
    if (action === "quote") {
      quoteIntoComposer(p.msg || { from: p.from, body: p.text, id: p.refId });
      return;
    }
    if (action === "forward") {
      const items = collectForwardables(p.refId ? [p.refId] : []);
      if (!items.length) {
        shellToast("这条不能转发");
        return;
      }
      openFwdSheet(items);
      return;
    }
    if (action === "fav") {
      await addFavoriteFromUi(p);
      return;
    }
    if (action === "multi") {
      enterMultiMode(p.refId);
      return;
    }
    if (action === "regen") {
      await regenerateBotMessage(p.refId);
      return;
    }
    if (action === "recall") {
      await recallChatMessageUi(p.refId);
      return;
    }
    if (action === "delete") {
      await deleteChatMessageUi(p.refId);
      return;
    }
  }
