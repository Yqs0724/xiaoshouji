  const PLUS_ITEMS = [
    { id: "album", lab: "相册", tile: "相册", ok: true },
    { id: "camera", lab: "拍摄", tile: "拍摄", ok: true },
    { id: "location", lab: "位置", tile: "位置", ok: true },
