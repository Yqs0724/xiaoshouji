    syncSendPlus();
    persistDraft();
    const payload = { kind: "text", body: body };
    if (pendingQuote) {
      payload.quote = { id: pendingQuote.id, who: pendingQuote.who, text: pendingQuote.text };
      clearPendingQuote();
    }
    await postChatPayload(payload);
  }

